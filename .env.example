# Restrict Google/Mapbox keys by Android package / iOS bundle ID.
# Mapbox also needs a secret download token for native builds — see docs/MAPBOX_AND_APK.md
# (RNMAPBOX_MAPS_DOWNLOAD_TOKEN / sk.…). Public token below is pk.… for runtime maps.

EXPO_PUBLIC_API_URL=https://your-backend.example
EXPO_PUBLIC_AI_API_URL=https://your-ai.example/api/v1
EXPO_PUBLIC_AI_API_KEY=
EXPO_PUBLIC_GOOGLE_API_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_URS_API_URL=https://your-urs.example/api/v1
EXPO_PUBLIC_URS_API_KEY=
EXPO_PUBLIC_APP_VARIANT=development

APP_VARIANT=development
# EAS_PROJECT_ID=
